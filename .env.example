# MongoDB Database Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=placement_db
USE_IN_MEMORY_DB=false

# Authentication Security
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Live Web Search & Verification API (Google CSE)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# AI Provider Configuration
AI_PROVIDER=google_openai_native
AI_API_KEY=your_ai_api_key_here

# Speech Processing Configuration
SPEECH_TO_TEXT_PROVIDER=whisper_browser_fallback
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_PROVIDER=native_web_speech
TEXT_TO_SPEECH_API_KEY=

# Frontend Application Origin
FRONTEND_URL=http://localhost:3000
